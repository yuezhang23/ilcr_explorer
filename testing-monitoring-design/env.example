# ICLR Backend Testing Configuration
# Copy this file to .env and update the values

# Your Render backend URL (replace with your actual URL)
RENDER_BASE_URL=https://your-app-name.onrender.com

# Local backend URL (for comparison)
LOCAL_BASE_URL=http://localhost:4000

# Testing configuration
TEST_COUNT=10
TIMEOUT_MS=30000

# Load testing configuration
LOAD_TEST_DURATION=300
LOAD_TEST_RATE=20
LOAD_TEST_PEAK_RATE=100

# Performance thresholds
MAX_ERROR_RATE=10
MAX_RESPONSE_TIME=5000
P95_THRESHOLD=3000
P99_THRESHOLD=8000
