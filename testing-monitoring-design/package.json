{
  "name": "iclr-backend-testing",
  "version": "1.0.0",
  "description": "Testing and monitoring tools for ICLR Rating Backend",
  "main": "scripts/speed-test.js",
  "scripts": {
    "speed-test": "node scripts/speed-test.js",
    "load-test": "artillery run load-tests/load-test.yml",
    "load-test:render": "artillery run load-tests/load-test-render.yml",
    "test:all": "npm run speed-test && npm run load-test:render",
    "install:artillery": "npm install -g artillery",
    "setup": "npm install && npm run install:artillery"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "artillery": "^2.0.0-27",
    "faker": "^6.6.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  },
  "keywords": [
    "testing",
    "performance",
    "load-testing",
    "speed-testing",
    "render",
    "backend"
  ],
  "author": "ICLR Rating Team",
  "license": "MIT"
}
